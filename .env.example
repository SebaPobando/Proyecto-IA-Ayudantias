# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio (ya está excluido en .gitignore).

# Llave de API del proveedor de modelo que estés usando (por ejemplo, OpenAI o Hugging Face)
API_KEY=tu_llave_aqui

# ProyectoIA hasta bloque 32. Completa solo en .env, nunca en Git.
GEMINI_API_KEY=
# Identificadores disponibles en tu cuenta; no se presupone un modelo vigente.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
RAG_INDEX_DIR=vectorstore_b32
# Tarifas verificadas por el usuario, USD por un millon de tokens.
# Si faltan, el costo queda null; no se asume costo cero.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
LANGSMITH_TRACING=false
